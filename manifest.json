{
  "name": "PhaseOut",
  "version": "0.1",
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "description": "Uses in-browser face recognition to remove selected faces from websites.",
  "background": {
    "service_worker": "src/sw.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["weights/*", "images/*", "src/face-api.min.js", "src/user_script.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "userScripts",
    "webNavigation"
  ],
  "host_permissions": [ "<all_urls>"],
  "action": {
    "default_popup": "html/popup.html"
  },
  "options_ui": {
    "page": "html/options.html",
    "open_in_tab": false
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/bridge.js"],
    "run_at": "document_start",
    "all_frames": true
  }]
}
